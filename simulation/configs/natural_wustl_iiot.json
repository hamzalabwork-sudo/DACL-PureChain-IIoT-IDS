{
  "extends": "base.json",
  "name": "natural_wustl_iiot",
  "dataset": {
    "type": "csv",
    "path": "../wustl_iiot_2021.csv",
    "label_col": "Traffic",
    "other_label_cols": [
      "Target"
    ],
    "drop_cols": [
      "StartTime",
      "LastTime",
      "SrcAddr",
      "DstAddr",
      "Sport",
      "Dport"
    ],
    "drop_duplicates": true,
    "time_col": "StartTime",
    "target_rows": 200000,
    "min_per_class": 3000
  },
  "scenario": {
    "type": "natural",
    "batch_size": 256,
    "pretrain_frac": 0.3,
    "n_segments": 4,
    "test_per_class": 1000,
    "test_frac": 0.15,
    "min_class_rows": 200,
    "normal": "normal"
  },
  "metrics": {
    "forgetting": {
      "group": "A",
      "after_phase": 3
    },
    "return_phase": 3
  }
}